msgstr "depuis le dernier rafraîchissement"

msgid "unchanged"
msgstr "inchangé"

msgid "until next refresh"
msgstr "avant le prochain rafraîchissement"

msgid "wp-config.php has no usable salt — credentials cannot be stored safely."
msgstr "wp-config.php ne contient aucun sel utilisable — les identifiants ne peuvent pas être enregistrés en sécurité."

