msgstr "Afficher le prix de renouvellement"

msgid "Shows the live registration and renewal price for a domain extension."
msgstr "Affiche le prix d'enregistrement et de renouvellement à jour d'une extension de domaine."

msgid "Sports"
msgstr "Sports"

msgid "Status"
msgstr "État"

msgid "Stored credentials are never sent back to the browser. Leave a field blank to keep its current value."
msgstr "Les identifiants enregistrés ne sont jamais renvoyés au navigateur. Laissez un champ vide pour conserver sa valeur actuelle."

msgid "Stored credentials cleared."
msgstr "Identifiants effacés."

msgid "TLD cannot be empty."
msgstr "Le TLD ne peut pas être vide."

msgid "Technology"
msgstr "Technologies"

msgid "Test API connection"
msgstr "Tester la connexion à l'API"

msgid "Test the API connection"
msgstr "Tester la connexion API"

msgid "The WHMCS API URL is empty or invalid."
msgstr "L'URL de l'API WHMCS est vide ou invalide."

msgid "The WHMCS API URL must use https://."
msgstr "L'URL de l'API WHMCS doit utiliser https://."

msgid "The WHMCS URL must start with https:// — the API credentials travel in the request body."
msgstr "L'URL de WHMCS doit commencer par https:// — les identifiants d'API circulent dans le corps de la requête."

msgid "Uses the page slug"
msgstr "Utilise l'identifiant de la page"

msgid "WHMCS API error: %s"
msgstr "Erreur de l'API WHMCS : %s"

msgid "WHMCS price"
msgstr "Prix WHMCS"

