msgstr "Retirer"

msgid "Renewal"
msgstr "Renouvellement"

msgid "Renewal:"
msgstr "Renouvellement :"

msgid "Renewal: %s"
msgstr "Renouvellement : %s"

msgid "Renews at the same price"
msgstr "Renouvellement au même prix"

msgid "Replaces the automatic currency formatting. Use it to match figures already written on the page."
msgstr "Remplace le formatage monétaire automatique. À utiliser pour s'accorder aux montants déjà écrits dans la page."

msgid "Save %1$d%% over %2$d years"
msgstr "Économisez %1$d %% sur %2$d ans"

msgid "Save %d%% the first year"
msgstr "Économisez %d %% la première année"

msgid "Save configuration"
msgstr "Enregistrer la configuration"

msgid "Search domain TLD"
msgstr "Chercher avec ce domaine"

msgid "Services"
msgstr "Services"

