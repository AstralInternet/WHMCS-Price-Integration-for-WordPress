msgstr "WHMCS a répondu par un code HTTP %d."

msgid "WHMCS did not return valid JSON. Check the API URL."
msgstr "WHMCS n'a pas renvoyé de JSON valide. Vérifiez l'URL de l'API."

msgid "WHMCS domain price"
msgstr "Prix de domaine WHMCS"

msgid "WHMCS refused the request."
msgstr "WHMCS a refusé la requête."

msgid "WHMCS refused this server's IP address. Add it to the API credential's allowed IPs."
msgstr "WHMCS a refusé l'adresse IP de ce serveur. Ajoutez-la aux adresses autorisées de l'identifiant d'API."

msgid "Was"
msgstr "Était"

msgid "You do not have permission to access this page."
msgstr "Vous n'avez pas l'autorisation d'accéder à cette page."

msgid "all"
msgstr "Tous"

msgid "domain"
msgstr "domaine"

msgid "en-CA"
msgstr "fr-CA"

